<?xml version="1.0" encoding="UTF-8" ?>
<!--
Authorship note:
This file follows standard .NET MAUI Shell navigation structure.
Microsoft documentation and MAUI navigation guidance were used for Shell and TabBar syntax.
The NutriAI page grouping and tab layout were chosen by the author.
-->
    <Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NutriAI.Views"
    x:Class="NutriAI.AppShell">

    <TabBar>

        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate views:SearchPage}" />

        <ShellContent
            Title="Saved"
            ContentTemplate="{DataTemplate views:SavedRecipesPage}" />

        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>

</Shell>

