<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.AccountSettingsPage"
    Title="Account Settings"
    BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- PROFILE -->
            <Label Text="Profile"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontAttributes="Bold" />

            <Entry
                Text="{Binding Name}"
                TextColor="{DynamicResource SecondaryTextColor}"
                Placeholder="Your name"
                HeightRequest="48"
                BackgroundColor="{DynamicResource CardBackground}"
                SemanticProperties.Hint="Your display name" />

            <!-- BODY DATA -->
            <Label Text="Body information (optional)"
                   FontAttributes="Bold"
                   Margin="0,12,0,0" />

            <Label Text="Used for future personalisation features."
                   FontSize="{DynamicResource BodyFontSize}"
                   TextColor="{DynamicResource SecondaryTextColor}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Entry Grid.Column="0"
                       Text="{Binding WeightKg}"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       Keyboard="Numeric"
                       Placeholder="Weight (kg)"
                       PlaceholderColor="{DynamicResource SecondaryTextColor}"
                       HeightRequest="48"
                       BackgroundColor="{DynamicResource CardBackground}" />

                
                <Entry Grid.Column="1"
                       Text="{Binding HeightCm}"
                       TextColor="{DynamicResource SecondaryTextColor}"
                       Keyboard="Numeric"
                       Placeholder="Height (cm)"
                       PlaceholderColor="{DynamicResource SecondaryTextColor}"
                       HeightRequest="48"
                       BackgroundColor="{DynamicResource CardBackground}" />

            </Grid>

            <!-- SAVE -->
            <Button Text="Save changes"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{DynamicResource AccentGreen}"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="50"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
