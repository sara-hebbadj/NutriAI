<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.HomePage"
    BackgroundColor="{DynamicResource PageBackground}">

    <!-- ROOT GRID -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= HEADER (CONSISTENT ACROSS APP) ================= -->
        <Grid Grid.Row="0"
              Padding="20,20,20,10"
              ColumnDefinitions="*,Auto">

            <Label Text="NutriAI"
                   FontSize="{StaticResource TitleFontSize}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AccentGreen}"
                   SemanticProperties.HeadingLevel="Level1"/>

        </Grid>
        <!-- FONT SIZE CONTROLS -->
        <Border
         BackgroundColor="{DynamicResource PageBackground}"
         Stroke="{DynamicResource PageBackground}"
         StrokeThickness="0"
         StrokeShape="RoundRectangle 16"
         Padding="0"
         HorizontalOptions="End"
         SemanticProperties.Description="Text size controls">

            <HorizontalStackLayout Spacing="1">

                <Button
                 Text="A"
                 Clicked="OnSmallFont"
                 BackgroundColor="{DynamicResource PageBackground}"
                 TextColor="{DynamicResource AccentGreen}"
                 CornerRadius="10"
                 FontSize="14"
                 SemanticProperties.Hint="Set small text size"/>

                <Button
                 Text="A"
                 Clicked="OnMediumFont"
                 BackgroundColor="{DynamicResource PageBackground}"
                 TextColor="{DynamicResource AccentGreen}"
                 CornerRadius="10"
                 FontSize="18"
                 SemanticProperties.Hint="Set medium text size"/>

                <Button
                 Text="A"
                 Clicked="OnLargeFont"
                 BackgroundColor="{DynamicResource PageBackground}"
                 TextColor="{DynamicResource AccentGreen}"
                 CornerRadius="10"
                 FontSize="20"
                 SemanticProperties.Hint="Set large text size"/>

            </HorizontalStackLayout>
        </Border>

        <!-- ================= SCROLLABLE CONTENT ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">

                <!-- SEARCH BAR -->
                <Border Margin="20,0"
        BackgroundColor="{DynamicResource DividerColor}"
        StrokeShape="RoundRectangle 15"
        HeightRequest="55">

                    <Grid ColumnDefinitions="*,Auto" Padding="15,0">

                        <Entry x:Name="SearchEntry"
               Placeholder="Ask for recipes..."
               TextColor="{DynamicResource PrimaryTextColor}"
               PlaceholderColor="{DynamicResource SecondaryTextColor}"
               TextChanged="OnSearchTextChanged"/>

                        <Border Grid.Column="1"
                BackgroundColor="{DynamicResource AccentGreen}"
                StrokeShape="RoundRectangle 10"
                WidthRequest="45"
                HeightRequest="35">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchTapped"/>
                            </Border.GestureRecognizers>

                            <Image Source="search_white.png"/>
                        </Border>

                    </Grid>
                </Border>

                <!-- FILTER CHIPS + FLYOUTS -->
                <VerticalStackLayout Padding="20,0" Spacing="10">

                    <HorizontalStackLayout Spacing="12">

                        <!-- MEAL TYPE -->
                        <Border x:Name="MealTypeChip"
                        Background="{DynamicResource ChipBackground}"
                        Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="15,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMealTypeTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="MealTypeLabel" Text="Meal Type" FontSize="15"/>
                                <Image Source="chevron_down.png" HeightRequest="14"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- DIET -->
                        <Border x:Name="DietChip"
                        Background="{DynamicResource ChipBackground}"
                        Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="15,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDietTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="DietLabel" Text="Diet" FontSize="15"/>
                                <Image Source="chevron_down.png" HeightRequest="14"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- CUISINE -->
                        <Border x:Name="CuisineChip"
                        Background="{DynamicResource ChipBackground}"
                        Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="15,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCuisineTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label x:Name="CuisineLabel" Text="Cuisine" FontSize="15"/>
                                <Image Source="chevron_down.png" HeightRequest="14"/>
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <!-- MEAL TYPE FLYOUT -->
                    <Border x:Name="MealTypeFlyout"
                    IsVisible="False"
                    Background="{DynamicResource ChipBackground}"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Breakfast" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                            <Label Text="Lunch" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                            <Label Text="Dinner" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                            <Label Text="Snack" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- DIET FLYOUT -->
                    <Border x:Name="DietFlyout"
                    IsVisible="False"
                    Background="{DynamicResource ChipBackground}"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Balanced" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                            <Label Text="Keto" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                            <Label Text="Vegan" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                            <Label Text="Vegetarian" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CUISINE FLYOUT -->
                    <Border x:Name="CuisineFlyout"
                    IsVisible="False"
                    Background="{DynamicResource ChipBackground}"
                    Stroke="{DynamicResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Italian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                            <Label Text="Asian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                            <Label Text="Middle Eastern" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                            <Label Text="American" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>


                <!-- SECTION TITLE -->
                <Label Text="Recommended For You"
                       FontSize="{DynamicResource TitleFontSize}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       Margin="20,10,20,0"/>

                <!-- RECIPE LIST (SCROLLS & TAPS CORRECTLY) -->

                <CollectionView x:Name="RecipesCollection"
                                ItemsSource="{Binding FilteredRecipes}"
                                SelectionMode="Single"
                                SelectionChanged="OnRecipeSelected"
                                Margin="20,0">


                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Stroke="{DynamicResource DividerColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 20"
                                Margin="0,0,0,20">

                                <VerticalStackLayout>

                                    <!-- RECIPE IMAGE -->
                                    <Border
                                      HeightRequest="160"
                                      StrokeShape="RoundRectangle 20"
                                      BackgroundColor="{DynamicResource DividerColor}"
                                      Padding="0">

                                        <Image
                                        Source="{Binding ImageUrl}"
                                        Aspect="AspectFill"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Image of {0}'}"/>

                                    </Border>


                                    <VerticalStackLayout Padding="16" Spacing="10">

                                        <!-- TITLE + CALORIES -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource PrimaryTextColor}"/>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Calories, StringFormat='🔥 {0} cal'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource SecondaryTextColor}"/>
                                        </Grid>

                                        <!-- TIME -->
                                        <Label
                                            Text="{Binding CookingTimeMinutes, StringFormat='⏱ {0} min'}"
                                            FontSize="{DynamicResource BodyFontSize}"
                                            TextColor="{DynamicResource SecondaryTextColor}"/>

                                        <!-- MACROS -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Label
                                                Text="{Binding ProteinGrams, StringFormat='Protein {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                            <Label
                                                Text="{Binding CarbsGrams, StringFormat='Carbs {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                            <Label
                                                Text="{Binding FatGrams, StringFormat='Fat {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
