<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.HomePage"
    BackgroundColor="white">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="apple_logo.png" HeightRequest="30"/>
                    <Label Text="NutriAI"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#2FAF4A" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15">
                    <Image Source="search_icon.png" HeightRequest="22"/>
                    <Image Source="bell_icon.png" HeightRequest="22"/>
                </HorizontalStackLayout>
            </Grid>


            <!-- SEARCH BAR -->
            <Border StrokeThickness="1"
                    Background="#E0E0E0"
                    StrokeShape="RoundRectangle 15"
                    HeightRequest="55">

                <Grid ColumnDefinitions="*,Auto" Padding="15,0">

                    <Entry Placeholder="Ask for recipes..."
                           PlaceholderColor="Black"
                           TextColor="Black"
                           FontSize="16"
                           FontAttributes="Italic"
                           BackgroundColor="Transparent"/>
                    <Border Grid.Column="1"
                            Background="#2FAF4A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="45"
                            HeightRequest="35"
                            VerticalOptions="Center">

                        <Image Source="search_white.png"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>


            <!-- FILTER CHIPS + FLYOUTS -->
            <VerticalStackLayout Spacing="10">

                <!-- CHIP ROW -->
                <HorizontalStackLayout Spacing="12">

                    <!-- MEAL TYPE -->
                    <Border x:Name="MealTypeChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMealTypeTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="MealTypeLabel" Text="Meal Type" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- DIET -->
                    <Border x:Name="DietChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDietTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="DietLabel" Text="Diet" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- CUISINE -->
                    <Border x:Name="CuisineChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCuisineTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="CuisineLabel" Text="Cuisine" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                </HorizontalStackLayout>

                <!-- MEAL TYPE FLYOUT -->
                <Border x:Name="MealTypeFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Breakfast" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Lunch" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Dinner" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Snack" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- DIET FLYOUT -->
                <Border x:Name="DietFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Balanced" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Keto" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Vegan" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Vegetarian" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- CUISINE FLYOUT -->
                <Border x:Name="CuisineFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Italian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="Asian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="Middle Eastern" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="American" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

    


            <!-- SECTION TITLE -->
            <Label Text="Recommended For You"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="Black" />


            <!-- RECIPE CARD -->
            <Border StrokeThickness="0"
                    Background="White"
                    StrokeShape="RoundRectangle 25"
                    Margin="0,0,0,10">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecipeTapped" />
                </Border.GestureRecognizers>


                <VerticalStackLayout Spacing="10">

                    <!-- IMAGE placeholder -->
                    <Border HeightRequest="180"
                            Background="#EDEDED"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 25"/>

                    <VerticalStackLayout Padding="15" Spacing="8">

                        <!-- Title -->
                        <Label Text="Grilled Chicken with Quinoa"
                               FontSize="20"
                               FontAttributes="Bold" />

                        <!-- Time + calories -->
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">

                            <HorizontalStackLayout Spacing="5">
                                <Image Source="clock_icon.png" HeightRequest="16"/>
                                <Label Text="25 min" TextColor="#707070" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                <Image Source="flame_icon.png" HeightRequest="16"/>
                                <Label Text="420 cal"
                                       TextColor="#707070" />
                            </HorizontalStackLayout>

                        </Grid>

                        <!-- TAGS -->
                        <HorizontalStackLayout Spacing="10">

                            <Border Background="#DFF4DF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,5">
                                <Label Text="Protein: 35g" FontSize="13" TextColor="#2FAF4A"/>
                            </Border>

                            <Border Background="#DFF4DF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,5">
                                <Label Text="Carbs: 45g" FontSize="13" TextColor="#2FAF4A"/>
                            </Border>

                            <Border Background="#DFF4DF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,5">
                                <Label Text="Fat: 12g" FontSize="13" TextColor="#2FAF4A"/>
                            </Border>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
