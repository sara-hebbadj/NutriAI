<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.ProfilePage"
    BackgroundColor="{DynamicResource PageBackground}">

    <!-- ROOT GRID -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= HEADER (CONSISTENT ACROSS APP) ================= -->
        <Grid Grid.Row="0"
              Padding="20,20,20,10"
              ColumnDefinitions="*,Auto">

            <Label Text="NutriAI"
                   FontSize="{StaticResource TitleFontSize}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AccentGreen}"
                   SemanticProperties.HeadingLevel="Level1"/>
        </Grid>

        <!-- FONT SIZE CONTROLS -->
            <Border
                BackgroundColor="{DynamicResource PageBackground}"
                Stroke="{DynamicResource PageBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="0"
                HorizontalOptions="End"
                SemanticProperties.Description="Text size controls">

                <HorizontalStackLayout Spacing="1">

                    <Button
                        Text="A"
                        Clicked="OnSmallFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="14"
                        SemanticProperties.Hint="Set small text size"/>

                    <Button
                        Text="A"
                        Clicked="OnMediumFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="18"
                        SemanticProperties.Hint="Set medium text size"/>

                    <Button
                        Text="A"
                        Clicked="OnLargeFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="20"
                        SemanticProperties.Hint="Set large text size"/>

                </HorizontalStackLayout>
            </Border>
        

        <!-- ================= SCROLLABLE CONTENT ================= -->
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="24">


            <!-- USER INFO SECTION -->
            <HorizontalStackLayout Spacing="15">

                <!-- Profile Icon -->
                <Border BackgroundColor="{DynamicResource ChipBackground}"
                        HeightRequest="75"
                        WidthRequest="75"
                        StrokeShape="RoundRectangle 50"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                    <Image Source="user_icon.png"
                           HeightRequest="40"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- Name + Goal -->
                <VerticalStackLayout Spacing="4"
                                     VerticalOptions="Center">
                        <Label Text="{Binding Name}"
                         FontSize="{DynamicResource TitleFontSize}"
                         FontAttributes="Bold"
                         TextColor="{DynamicResource PrimaryTextColor}"/>


                        <Label Text="{Binding GoalSummary}"
                         FontSize="{DynamicResource BodyFontSize}"
                         TextColor="{DynamicResource SecondaryTextColor}"/>

                    </VerticalStackLayout>

            </HorizontalStackLayout>


            <!-- STATS SECTION -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                <!-- Recipes Saved -->
                <Border BackgroundColor="{DynamicResource ChipBackground}"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding RecipesSaved}"
                             FontSize="{DynamicResource TitleFontSize}"
                             FontAttributes="Bold"
                             TextColor="{DynamicResource AccentGreen}"
                             HorizontalOptions="Center"/>

                            <Label Text="Recipes Saved"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextColor="{DynamicResource AccentGreen}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Meals Logged -->
                <Border BackgroundColor="{DynamicResource ChipBackground}"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18"
                        Grid.Column="1">
                    <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding RecipesViewed}" />
                            <Label Text="Meals Logged"
                               FontSize="{DynamicResource BodyFontSize}"
                               TextColor="{DynamicResource AccentGreen}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Weight Lost -->
                <Border BackgroundColor="{DynamicResource ChipBackground}"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18"
                        Grid.Column="2">
                    <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding WeightLost}"
                             FontSize="{DynamicResource TitleFontSize}"
                             FontAttributes="Bold"
                       TextColor="{DynamicResource AccentGreen}"
                             HorizontalOptions="Center"/>
                            <Label Text="kg Lost"
                            FontSize="{DynamicResource BodyFontSize}"
                            TextColor="{DynamicResource AccentGreen}"
                            HorizontalOptions="Center"/>

                        </VerticalStackLayout>
                </Border>
                    <!-- Meals Cooked -->
                    <Border BackgroundColor="{DynamicResource ChipBackground}"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18"
                        Grid.Column="1">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding MealsCooked}"  
                                   FontSize="{DynamicResource TitleFontSize}"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Meals Cooked"
                               TextColor="{DynamicResource AccentGreen}"
                               HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>


            <!-- MENU LIST -->
                <!-- MENU LIST -->
                <VerticalStackLayout Spacing="12">

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto"
              Padding="14"
              SemanticProperties.Description="Dietary preferences">
                            <Label Text="Dietary Preferences"
                   FontSize="{DynamicResource BodyFontSize}"
                   VerticalOptions="Center" />

                            <Label Text="›"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource SecondaryTextColor}" />

                            <Button Command="{Binding OpenPageCommand}"
                    CommandParameter="DietaryPreferencesPage"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    SemanticProperties.Hint="Open dietary preferences"/>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto"
              Padding="14"
              SemanticProperties.Description="Health goals">
                            <Label Text="Health Goals"
                   FontSize="{DynamicResource BodyFontSize}"
                   VerticalOptions="Center" />

                            <Label Text="›"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource SecondaryTextColor}" />

                            <Button Command="{Binding OpenPageCommand}"
                    CommandParameter="HealthGoalsPage"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    SemanticProperties.Hint="Open health goals"/>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto"
              Padding="14"
              SemanticProperties.Description="Allergies and restrictions">
                            <Label Text="Allergies and Restrictions"
                   FontSize="{DynamicResource BodyFontSize}"
                   VerticalOptions="Center" />

                            <Label Text="›"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource SecondaryTextColor}" />

                            <Button Command="{Binding OpenPageCommand}"
                    CommandParameter="AllergiesPage"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    SemanticProperties.Hint="Open allergies and restrictions"/>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto"
              Padding="14"
              SemanticProperties.Description="Account settings">
                            <Label Text="Account Settings"
                   FontSize="{DynamicResource BodyFontSize}"
                   VerticalOptions="Center" />

                            <Label Text="›"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource SecondaryTextColor}" />

                            <Button Command="{Binding OpenPageCommand}"
                    CommandParameter="AccountSettingsPage"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    SemanticProperties.Hint="Open account settings"/>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto"
              Padding="14"
              SemanticProperties.Description="Help and support">
                            <Label Text="Help and Support"
                   FontSize="{DynamicResource BodyFontSize}"
                   VerticalOptions="Center" />

                            <Label Text="›"
                   Grid.Column="1"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="{DynamicResource SecondaryTextColor}" />

                            <Button Command="{Binding OpenPageCommand}"
                    CommandParameter="HelpSupportPage"
                    BackgroundColor="Transparent"
                    Opacity="0"
                    SemanticProperties.Hint="Open help and support"/>
                        </Grid>
                    </Border>

                </VerticalStackLayout>


            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
