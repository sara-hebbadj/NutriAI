<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.ProfilePage"
    BackgroundColor="#FAFAFA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="apple_logo.png" HeightRequest="30"/>
                    <Label Text="NutriAI"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#2FAF4A"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15">
                    <Image Source="search_icon.png" HeightRequest="22"/>
                    <Image Source="bell_icon.png" HeightRequest="22"/>
                </HorizontalStackLayout>
            </Grid>


            <!-- USER INFO SECTION -->
            <HorizontalStackLayout Spacing="15">

                <!-- Profile Icon -->
                <Border BackgroundColor="#D7EDDA"
                        HeightRequest="75"
                        WidthRequest="75"
                        StrokeShape="RoundRectangle 50"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                    <Image Source="user_icon.png"
                           HeightRequest="40"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- Name + Goal -->
                <VerticalStackLayout Spacing="4"
                                     VerticalOptions="Center">
                    <Label Text="Sara Hebbadj"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#222"/>

                    <Label Text="Weight Loss Goal • 1,800 cal/day"
                           FontSize="14"
                           TextColor="#555"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>


            <!-- STATS SECTION -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">

                <!-- Recipes Saved -->
                <Border BackgroundColor="#D7EDDA"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="12"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                        <Label Text="Recipes Saved"
                               FontSize="13"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Meals Logged -->
                <Border BackgroundColor="#D7EDDA"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18"
                        Grid.Column="1">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="28"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                        <Label Text="Meals Logged"
                               FontSize="13"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Weight Lost -->
                <Border BackgroundColor="#D7EDDA"
                        Padding="15,10"
                        StrokeShape="RoundRectangle 18"
                        Grid.Column="2">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="5.2"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                        <Label Text="kg Lost"
                               FontSize="13"
                               TextColor="#234B2A"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>


            <!-- MENU LIST -->
            <VerticalStackLayout>

                <Button Text="Dietary Preferences"
                        TextColor="Black"
                        Background="White"
                        BorderWidth="1"
                        BorderColor="Black"
            Command="{Binding OpenPageCommand}"
            CommandParameter="DietaryPreferencesPage"/>

                <Button Text="Health Goals"
                        TextColor="Black"
                        Background="white"
                        BorderWidth="1"
                        BorderColor="Black"
            Command="{Binding OpenPageCommand}"
            CommandParameter="HealthGoalsPage"/>

                <Button Text="Allergies and Restrictions"
                        TextColor="Black"
                        Background="White"
            Command="{Binding OpenPageCommand}"
            CommandParameter="AllergiesPage"/>

                <Button Text="Account Settings"
                        TextColor="Black"
                        Background="White"
            Command="{Binding OpenPageCommand}"
            CommandParameter="AccountSettingsPage"/>

                <Button Text="Help and Support"
                        Background="White"
                        TextColor="Black"
            Command="{Binding OpenPageCommand}"
            CommandParameter="HelpSupportPage"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
