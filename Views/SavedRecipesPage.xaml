<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.SavedRecipesPage"
    BackgroundColor="{DynamicResource PageBackground}">

    <!-- ROOT GRID -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= HEADER (CONSISTENT ACROSS APP) ================= -->
        <Grid Grid.Row="0"
              Padding="20,20,20,10"
              ColumnDefinitions="*,Auto">

            <Label Text="NutriAI"
                   FontSize="{StaticResource TitleFontSize}"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource AccentGreen}"
                   SemanticProperties.HeadingLevel="Level1"/>
        </Grid>

        <!-- FONT SIZE CONTROLS -->
            <Border
                BackgroundColor="{DynamicResource PageBackground}"
                Stroke="{DynamicResource PageBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="0"
                HorizontalOptions="End"
                SemanticProperties.Description="Text size controls">

                <HorizontalStackLayout Spacing="1">

                    <Button
                        Text="A"
                        Clicked="OnSmallFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="14"
                        SemanticProperties.Hint="Set small text size"/>

                    <Button
                        Text="A"
                        Clicked="OnMediumFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="18"
                        SemanticProperties.Hint="Set medium text size"/>

                    <Button
                        Text="A"
                        Clicked="OnLargeFont"
                        BackgroundColor="{DynamicResource PageBackground}"
                        TextColor="{DynamicResource AccentGreen}"
                        CornerRadius="10"
                        FontSize="20"
                        SemanticProperties.Hint="Set large text size"/>

                </HorizontalStackLayout>
            </Border>
      

        <!-- ================= SCROLLABLE CONTENT ================= -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- PAGE TITLE -->
                <Label Text="Saved Recipes"
                       FontSize="{DynamicResource TitleFontSize}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryTextColor}"/>

                <!-- SAVED RECIPES LIST -->
                <CollectionView
                    ItemsSource="{Binding SavedRecipes}"
                    SelectionMode="Single"
                    SelectionChanged="OnRecipeSelected">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Stroke="{DynamicResource DividerColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 20"
                                Margin="0,0,0,20">

                                <VerticalStackLayout>

                                    <!-- IMAGE PLACEHOLDER -->
                                    <Border
                                        BackgroundColor="{DynamicResource DividerColor}"
                                        HeightRequest="160"
                                        StrokeShape="RoundRectangle 20"/>

                                    <VerticalStackLayout Padding="16" Spacing="10">

                                        <!-- TITLE + CALORIES -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                FontAttributes="Bold"
                                                TextColor="{DynamicResource PrimaryTextColor}"/>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Calories, StringFormat='🔥 {0} cal'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource SecondaryTextColor}"/>
                                        </Grid>

                                        <!-- TIME -->
                                        <Label
                                            Text="{Binding CookingTimeMinutes, StringFormat='⏱ {0} min'}"
                                            FontSize="{DynamicResource BodyFontSize}"
                                            TextColor="{DynamicResource SecondaryTextColor}"/>

                                        <!-- MACROS -->
                                        <HorizontalStackLayout Spacing="10">
                                            <Label
                                                Text="{Binding ProteinGrams, StringFormat='Protein {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                            <Label
                                                Text="{Binding CarbsGrams, StringFormat='Carbs {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                            <Label
                                                Text="{Binding FatGrams, StringFormat='Fat {0}g'}"
                                                FontSize="{DynamicResource BodyFontSize}"
                                                TextColor="{DynamicResource AccentGreen}"/>
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>