<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.SearchPage"
    BackgroundColor="#FAFAFA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="apple_logo.png" HeightRequest="30"/>
                    <Label Text="NutriAI"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#2FAF4A"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15">
                    <Image Source="search_icon.png" HeightRequest="22"/>
                    <Image Source="bell_icon.png" HeightRequest="22"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- PAGE TITLE -->
            <Label Text="Search Recipes"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1C1C1C"/>

            <!-- SEARCH BAR -->
            <Border StrokeThickness="1"
                    Stroke="#E0E0E0"
                    Background="White"
                    StrokeShape="RoundRectangle 15"
                    HeightRequest="55">

                <Grid ColumnDefinitions="*,Auto" Padding="15,0">

                    <Entry Placeholder="Try: 'high-protein dinner under 600 calories'"
                           PlaceholderColor="#A0A0A0"
                           TextColor="Black"
                           FontSize="16"
                           BackgroundColor="Transparent"/>

                    <Border Grid.Column="1"
                            Background="#2FAF4A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="45"
                            HeightRequest="35"
                            VerticalOptions="Center">

                        <Image Source="search_white.png"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- FILTER CHIPS + FLYOUTS -->
            <VerticalStackLayout Spacing="10">

                <!-- CHIP ROW -->
                <HorizontalStackLayout Spacing="12">

                    <!-- MEAL TYPE -->
                    <Border x:Name="MealTypeChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMealTypeTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="MealTypeLabel" Text="Meal Type" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- DIET -->
                    <Border x:Name="DietChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDietTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="DietLabel" Text="Diet" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- CUISINE -->
                    <Border x:Name="CuisineChip"
                Background="White"
                Stroke="#E0E0E0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCuisineTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label x:Name="CuisineLabel" Text="Cuisine" FontSize="15"/>
                            <Image Source="chevron_down.png" HeightRequest="14"/>
                        </HorizontalStackLayout>
                    </Border>

                </HorizontalStackLayout>

                <!-- MEAL TYPE FLYOUT -->
                <Border x:Name="MealTypeFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Breakfast" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Lunch" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Dinner" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                        <Label Text="Snack" GestureRecognizers="{TapGestureRecognizer Tapped=OnMealTypeSelected}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- DIET FLYOUT -->
                <Border x:Name="DietFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Balanced" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Keto" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Vegan" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                        <Label Text="Vegetarian" GestureRecognizers="{TapGestureRecognizer Tapped=OnDietSelected}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- CUISINE FLYOUT -->
                <Border x:Name="CuisineFlyout"
            IsVisible="False"
            Background="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Italian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="Asian" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="Middle Eastern" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                        <Label Text="American" GestureRecognizers="{TapGestureRecognizer Tapped=OnCuisineSelected}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>


            <!-- (Empty space for now—results will appear here later) -->
            <Grid HeightRequest="300"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
