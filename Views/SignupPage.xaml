<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriAI.Views.SignupPage"
    BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="apple_logo.png" HeightRequest="30"/>
                    <Label Text="NutriAI"
                           FontSize="{StaticResource TitleFontSize}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentGreen}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="15">
                    <Image Source="search_icon.png" HeightRequest="22"/>
                    <Image Source="bell_icon.png" HeightRequest="22"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- LOGIN / SIGNUP TABS -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,2">

                <!-- Tab labels -->
                <Label Text="Log In"
                       Grid.Column="0"
                       HorizontalTextAlignment="Center"
                       FontSize="{StaticResource BodyFontSize}"
                       TextColor="{DynamicResource SecondaryTextColor}"/>

                <Label Text="Sign Up"
                       Grid.Column="1"
                       HorizontalTextAlignment="Center"
                       FontSize="{StaticResource BodyFontSize}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource AccentGreen}"/>

                <!-- Underline -->
                <BoxView Grid.Row="1"
                         Grid.Column="1"
                         HeightRequest="2"
                         BackgroundColor="{DynamicResource AccentGreen}"/>
            </Grid>

            <!-- FULL NAME -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Full Name"
                       FontSize="{StaticResource BodyFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"/>

                <Border Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="50">

                    <Entry Placeholder="Your full name"
                           BackgroundColor="Transparent"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           PlaceholderColor="{DynamicResource SecondaryTextColor}"
                           Margin="12,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- EMAIL -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Email"
                       FontSize="{StaticResource BodyFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"/>

                <Border Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="50">

                    <Entry Placeholder="example@mail.com"
                           Keyboard="Email"
                           BackgroundColor="Transparent"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           PlaceholderColor="{DynamicResource SecondaryTextColor}"
                           Margin="12,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- PASSWORD -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Password"
                       FontSize="{StaticResource BodyFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"/>

                <Border Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="50">

                    <Entry Placeholder="Enter password"
                           IsPassword="True"
                           BackgroundColor="Transparent"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           PlaceholderColor="{DynamicResource SecondaryTextColor}"
                           Margin="12,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- CONFIRM PASSWORD -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Confirm Password"
                       FontSize="{StaticResource BodyFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"/>

                <Border Stroke="{DynamicResource DividerColor}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="50">

                    <Entry Placeholder="Confirm password"
                           IsPassword="True"
                           BackgroundColor="Transparent"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           PlaceholderColor="{DynamicResource SecondaryTextColor}"
                           Margin="12,0"/>
                </Border>
            </VerticalStackLayout>

            <!-- SIGN UP BUTTON -->
            <Border BackgroundColor="{DynamicResource AccentGreen}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    HeightRequest="55"
                    Margin="0,20,0,0">

                <Button Text="Sign Up"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="{StaticResource BodyFontSize}"
                        FontAttributes="Bold"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
